# 이 파일을 복사해서 .env 로 이름을 바꾸고, 발급받은 값으로 채워주세요.
# (설정 방법은 README.md의 "소셜 로그인 설정하기" 참고)

SESSION_SECRET=아무-랜덤한-문자열로-바꿔주세요

# 이 이메일로 회원가입/로그인하면 "운영자" 화면(신고 관리)에 들어갈 수 있어요.
# 여러 명이면 콤마로 구분 (예: me@example.com,partner@example.com)
ADMIN_EMAILS=

# 카카오 디벨로퍼스 (https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 구글 클라우드 콘솔 (https://console.cloud.google.com) > API 및 서비스 > 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# 이메일 인증 · 비밀번호 찾기 메일을 보낼 Gmail 계정.
# GMAIL_APP_PASSWORD는 일반 로그인 비밀번호가 아니라 "앱 비밀번호"예요.
# 구글 계정 > 보안 > 2단계 인증을 켠 뒤 "앱 비밀번호"에서 발급받아 채워주세요.
# 비워두면 실제 메일을 보내는 대신 서버 콘솔에 인증/재설정 링크를 출력해요 (개발용).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 인증/재설정 메일에 넣을 링크의 기준 주소. 배포하면 실제 도메인으로 바꿔주세요.
APP_BASE_URL=http://localhost:3000

# 이미지 업로드(글 첨부, 프로필 사진)용 Cloudinary 계정.
# https://cloudinary.com 무료가입 > 대시보드(console.cloudinary.com) > API Keys 메뉴에서 확인
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
